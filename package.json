{
  "name": "gazboard",
  "productName": "GazBoard",
  "version": "2.6.0",
  "description": "A free-form digital whiteboard - offline replica of the classic Microsoft Whiteboard 21.x experience, with Word / PowerPoint / PDF import.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "smoke": "node scripts/smoke.js",
    "smoke:builtin": "node scripts/smoke.js --builtin",
    "smoke:headless": "node scripts/smoke.js --builtin --headless",
    "test:restart": "sh test/restart-test.sh",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "smoke:mac": "node scripts/smoke.js",
    "build:web": "node scripts/build-web.js",
    "serve:web": "node scripts/serve-web.js",
    "dev:web": "node scripts/serve-web.js",
    "test:web": "npm run build:web && node test/web-pwa.test.js",
    "test": "npm run smoke",
    "test:sync": "node test/sync.test.js",
    "sync:receive": "node scripts/sync-demo.js receive",
    "sync:send": "node scripts/sync-demo.js send",
    "sync:discover": "node scripts/sync-demo.js discover",
    "build:sync-demo": "node scripts/build-sync-demo.js"
  },
  "author": {
    "name": "theBoringCodes",
    "email": "fahim9778@gmail.com"
  },
  "homepage": "https://github.com/fahim9778/GazBoard",
  "repository": {
    "type": "git",
    "url": "https://github.com/fahim9778/GazBoard"
  },
  "contributors": [
    {
      "name": "MD. Fakhruddin Gazzali",
      "email": "fahim9778@gmail.com"
    }
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "pdfjs-dist": "4.10.38"
  },
  "build": {
    "appId": "com.theboringcode.gazboard",
    "productName": "GazBoard",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "!src/package.json",
      "sync/**/*",
      "package.json",
      "!test/out/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/assets/icon.ico",
      "legalTrademarks": "theBoringCodes",
      "signtoolOptions": {
        "publisherName": "theBoringCodes"
      }
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "src/assets/icon.icns",
      "identity": null,
      "darkModeSupport": true,
      "extendInfo": {
        "NSHighResolutionCapable": true,
        "LSMinimumSystemVersion": "11.0"
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "src/assets/icon.png",
      "synopsis": "Offline whiteboard with Word / PowerPoint / PDF import",
      "description": "A free-form digital whiteboard for pen, sticky notes, shapes, text, images and documents. Runs entirely on your own computer - no account, no sign-in, no cloud.",
      "maintainer": "theBoringCodes <fahim9778@gmail.com>",
      "desktop": {
        "entry": {
          "Name": "GazBoard",
          "StartupWMClass": "gazboard"
        }
      },
      "syncDesktopName": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GazBoard",
      "uninstallDisplayName": "GazBoard ${version}",
      "artifactName": "GazBoard-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "GazBoard-${version}-portable.exe"
    },
    "fileAssociations": [
      {
        "ext": "gazboard",
        "name": "GazBoard board",
        "description": "GazBoard whiteboard",
        "role": "Editor",
        "icon": "src/assets/icon.ico"
      },
      {
        "ext": "openboard",
        "name": "GazBoard board (legacy)",
        "description": "GazBoard whiteboard",
        "role": "Editor",
        "icon": "src/assets/icon.ico"
      }
    ],
    "publish": null,
    "dmg": {
      "title": "GazBoard ${version}",
      "contents": [
        {
          "x": 140,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "desktopName": "gazboard.desktop"
}
