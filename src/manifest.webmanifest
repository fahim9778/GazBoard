{
  "name": "GazBoard",
  "short_name": "GazBoard",
  "description": "A free-form digital whiteboard - offline replica of the classic Microsoft Whiteboard experience, with Word / PowerPoint / PDF import.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f3f2f1",
  "theme_color": "#6264a7",
  "categories": [
    "productivity",
    "utilities",
    "education"
  ],
  "icons": [
    {
      "src": "assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "name": "GazBoard Whiteboard",
      "accept": {
        "application/json": [".gazboard", ".openboard", ".json"]
      }
    }
  ]
}
