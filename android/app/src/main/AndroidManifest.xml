<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

  <application android:name=".GazBoardApplication" android:label="GazBoard Probe"
    android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:theme="@style/AppTheme"
    android:allowBackup="false" android:usesCleartextTraffic="false"
    android:supportsRtl="true" android:hardwareAccelerated="true">

    <!-- This branch is diagnostic only. MainActivity intentionally has no VIEW
         filters; every Open-with candidate below has a unique label so the real
         phone tells us exactly which resolver rule it matched. -->
    <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
      android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden|keyboard|uiMode"
      android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="*/*" />
      </intent-filter>
    </activity>

    <!-- 1: provider gives our preferred custom MIME. -->
    <activity-alias android:name=".ProbeGazboardMimeAlias"
      android:targetActivity=".MainActivity" android:enabled="true" android:exported="true"
      android:label="GB Probe: MIME" android:icon="@mipmap/ic_launcher">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <category android:name="android.intent.category.OPENABLE" />
        <data android:scheme="content" android:mimeType="application/x-gazboard" />
      </intent-filter>
    </activity-alias>

    <!-- 2: provider labels an unknown custom file as generic binary data. -->
    <activity-alias android:name=".ProbeOctetStreamAlias"
      android:targetActivity=".MainActivity" android:enabled="true" android:exported="true"
      android:label="GB Probe: Binary" android:icon="@mipmap/ic_launcher">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <category android:name="android.intent.category.OPENABLE" />
        <data android:scheme="content" android:mimeType="application/octet-stream" />
      </intent-filter>
    </activity-alias>

    <!-- 3: exact MediaStore URI shape observed on the Samsung device. -->
    <activity-alias android:name=".ProbeMediaStoreAlias"
      android:targetActivity=".MainActivity" android:enabled="true" android:exported="true"
      android:label="GB Probe: MediaStore" android:icon="@mipmap/ic_launcher">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <category android:name="android.intent.category.OPENABLE" />
        <data android:scheme="content" android:host="media" android:pathPrefix="/external/file/" />
      </intent-filter>
    </activity-alias>

    <!-- 4: URI exposes the actual board suffix. API 31+ supports pathSuffix. -->
    <activity-alias android:name=".ProbeSuffixAlias"
      android:targetActivity=".MainActivity" android:enabled="true" android:exported="true"
      android:label="GB Probe: Suffix" android:icon="@mipmap/ic_launcher">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <category android:name="android.intent.category.OPENABLE" />
        <data android:scheme="content" android:host="*" android:mimeType="*/*" />
        <data android:pathSuffix=".gazboard" />
        <data android:pathSuffix=".openboard" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <category android:name="android.intent.category.OPENABLE" />
        <data android:scheme="content" android:host="*" />
        <data android:pathSuffix=".gazboard" />
        <data android:pathSuffix=".openboard" />
      </intent-filter>
    </activity-alias>

    <!-- 5: broad typed content fallback. If this is the only working rule, it
         explains why the old manifest polluted Open-with for normal file types. -->
    <activity-alias android:name=".ProbeAnyTypedContentAlias"
      android:targetActivity=".MainActivity" android:enabled="true" android:exported="true"
      android:label="GB Probe: Any typed" android:icon="@mipmap/ic_launcher">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <category android:name="android.intent.category.OPENABLE" />
        <data android:scheme="content" android:mimeType="*/*" />
      </intent-filter>
    </activity-alias>

    <!-- 6: broad untyped content fallback. This isolates file managers that hide
         both MIME and filename from Android while resolving the tap. -->
    <activity-alias android:name=".ProbeAnyUntypedContentAlias"
      android:targetActivity=".MainActivity" android:enabled="true" android:exported="true"
      android:label="GB Probe: Any untyped" android:icon="@mipmap/ic_launcher">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <category android:name="android.intent.category.OPENABLE" />
        <data android:scheme="content" />
      </intent-filter>
    </activity-alias>

    <service android:name=".SharingService" android:exported="false"
      android:foregroundServiceType="connectedDevice" android:stopWithTask="true" />
    <provider android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.files" android:exported="false" android:grantUriPermissions="true">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
    </provider>
  </application>
</manifest>
